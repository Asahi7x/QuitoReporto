<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QuitoReporto.App.ViewModels.Ciudadano"
             xmlns:m="clr-namespace:QuitoReporto.App.Models"
             xmlns:h="clr-namespace:QuitoReporto.App.Helpers"
             x:Class="QuitoReporto.App.Views.Ciudadano.DetalleReportePage"
             x:DataType="vm:DetalleReporteViewModel"
             Title="Reporte"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">

    <Grid RowDefinitions="*,Auto">
        <ActivityIndicator IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}"
                           VerticalOptions="Center" HorizontalOptions="Center" ZIndex="1" />

        <ScrollView IsVisible="{Binding Cargado}">
            <VerticalStackLayout Padding="0,0,0,24">

                <!-- Foto -->
                <Grid HeightRequest="260" IsVisible="{Binding Reporte.TieneFoto}"
                      BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}">
                    <Image Source="{Binding Reporte.FotoUrl}" Aspect="AspectFill" />
                </Grid>

                <VerticalStackLayout Padding="20,20,20,0" Spacing="24">

                    <!-- Encabezado -->
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="8">
                            <Border Style="{StaticResource Etiqueta}" BackgroundColor="{Binding Reporte.Estado, Converter={StaticResource EstadoAFondo}}">
                                <HorizontalStackLayout Spacing="6">
                                    <Border WidthRequest="6" HeightRequest="6" StrokeShape="RoundRectangle 3" VerticalOptions="Center"
                                            BackgroundColor="{Binding Reporte.Estado, Converter={StaticResource EstadoATexto}}" />
                                    <Label Text="{Binding Reporte.EstadoTexto}" FontSize="12" FontFamily="InterSemiBold"
                                           TextColor="{Binding Reporte.Estado, Converter={StaticResource EstadoATexto}}" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border Style="{StaticResource Etiqueta}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Style="{StaticResource Icono}" Text="{Binding Reporte.CategoriaIcono}" FontSize="12" />
                                    <Label Text="{Binding Reporte.CategoriaTexto}" FontSize="12" FontFamily="InterMedium"
                                           TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                                </HorizontalStackLayout>
                            </Border>
                        </HorizontalStackLayout>

                        <Label Text="{Binding Reporte.Titulo}" Style="{StaticResource TextoTitulo}" />

                        <HorizontalStackLayout Spacing="6">
                            <Label Style="{StaticResource Icono}" Text="{x:Static h:Iconos.Usuario}" FontSize="14" />
                            <Label Text="{Binding Reporte.Autor}" Style="{StaticResource TextoPequeno}" />
                            <Label Text="·" Style="{StaticResource TextoPequeno}" Margin="2,0" />
                            <Label Style="{StaticResource Icono}" Text="{x:Static h:Iconos.Calendario}" FontSize="14" />
                            <Label Text="{Binding Reporte.FechaTexto}" Style="{StaticResource TextoPequeno}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Ubicación -->
                    <Border Style="{StaticResource Tarjeta}" Padding="12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Style="{StaticResource IconoFondo}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySubtle}, Dark={StaticResource PrimarySubtleDark}}">
                                <Label Style="{StaticResource Icono}" Text="{x:Static h:Iconos.Pin}" FontSize="18"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            </Border>
                            <Label Grid.Column="1" Text="{Binding Reporte.Ubicacion}" FontSize="14" VerticalOptions="Center" />
                            <Button Grid.Column="2" Text="Abrir" Style="{StaticResource BotonTonal}" HeightRequest="36" Padding="14,0"
                                    FontSize="13" Command="{Binding AbrirEnMapasCommand}" />
                        </Grid>
                    </Border>

                    <!-- Descripción -->
                    <Label Text="{Binding Reporte.Descripcion}" FontSize="15" LineHeight="1.4"
                           IsVisible="{Binding Reporte.Descripcion, Converter={StaticResource NoVacio}}" />

                    <!-- CU-07 Apoyar -->
                    <Button Text="{Binding TextoApoyo}" Style="{StaticResource BotonTonal}" Command="{Binding ApoyarCommand}"
                            IsVisible="{Binding PuedeApoyar}" />
                    <Border Style="{StaticResource Tarjeta}" Padding="12"
                            IsVisible="{Binding PuedeApoyar, Converter={StaticResource BoolInverso}}">
                        <HorizontalStackLayout Spacing="10">
                            <Label Style="{StaticResource Icono}" Text="{x:Static h:Iconos.Apoyo}" FontSize="16" />
                            <Label Style="{StaticResource TextoSecundario}" VerticalOptions="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Reporte.Apoyos}" FontFamily="InterSemiBold"
                                              TextColor="{AppThemeBinding Light={StaticResource Text}, Dark={StaticResource TextDark}}" />
                                        <Span Text=" vecinos apoyan tu reporte" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- CU-09 Cambiar estado (solo administrador) -->
                    <Border Style="{StaticResource Tarjeta}" IsVisible="{Binding EsAdministrador}">
                        <VerticalStackLayout Spacing="12">
                            <HorizontalStackLayout Spacing="8">
                                <Label Style="{StaticResource Icono}" Text="{x:Static h:Iconos.Escudo}" FontSize="16" />
                                <Label Text="Actualizar estado" Style="{StaticResource TextoFuerte}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Button Text="Recibido" Style="{StaticResource BotonSecundario}" FontSize="13" Padding="4,0" HeightRequest="40"
                                        TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                                        Command="{Binding CambiarEstadoCommand}" CommandParameter="Recibido" />
                                <Button Grid.Column="1" Text="En proceso" Style="{StaticResource BotonSecundario}" FontSize="13" Padding="4,0" HeightRequest="40"
                                        TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                        Command="{Binding CambiarEstadoCommand}" CommandParameter="EnProceso" />
                                <Button Grid.Column="2" Text="Resuelto" Style="{StaticResource BotonSecundario}" FontSize="13" Padding="4,0" HeightRequest="40"
                                        TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                        Command="{Binding CambiarEstadoCommand}" CommandParameter="Resuelto" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <BoxView Style="{StaticResource Separador}" />

                    <!-- Línea de tiempo -->
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Seguimiento" Style="{StaticResource TextoSeccion}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Historial}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="m:CambioEstado">
                                    <Grid ColumnDefinitions="20,*" ColumnSpacing="12" Padding="0,0,0,16">
                                        <BoxView WidthRequest="1.5" HorizontalOptions="Center" Margin="0,16,0,-16" />
                                        <Border WidthRequest="12" HeightRequest="12" StrokeShape="RoundRectangle 6" VerticalOptions="Start"
                                                Margin="0,3,0,0" StrokeThickness="3"
                                                Stroke="{Binding Estado, Converter={StaticResource EstadoAFondo}}"
                                                BackgroundColor="{Binding Estado, Converter={StaticResource EstadoAColor}}" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding Titulo}" Style="{StaticResource TextoFuerte}" FontSize="14" />
                                            <Label Text="{Binding FechaTexto}" Style="{StaticResource TextoPequeno}" FontSize="12" />
                                            <Border IsVisible="{Binding TieneNota}" Padding="10,8" Margin="0,6,0,0" StrokeShape="RoundRectangle 8"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}">
                                                <Label Text="{Binding Nota}" FontSize="14" />
                                            </Border>
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- CU-07 Comentarios -->
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Comentarios" Style="{StaticResource TextoSeccion}" />
                        <Label Text="Todavía no hay comentarios." Style="{StaticResource TextoSecundario}"
                               IsVisible="{Binding SinComentarios}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Comentarios}" Spacing="16">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="m:Comentario">
                                    <Grid ColumnDefinitions="32,*" ColumnSpacing="12">
                                        <Border WidthRequest="32" HeightRequest="32" StrokeShape="RoundRectangle 16" VerticalOptions="Start"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySubtle}, Dark={StaticResource PrimarySubtleDark}}">
                                            <Label Text="{Binding Inicial}" HorizontalOptions="Center" VerticalOptions="Center" FontSize="13"
                                                   FontFamily="InterSemiBold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding Autor}" Style="{StaticResource TextoFuerte}" FontSize="14" />
                                                <Label Text="{Binding FechaTexto}" Style="{StaticResource TextoPequeno}" FontSize="12" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding Texto}" FontSize="14" LineHeight="1.35" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Nuevo comentario -->
        <Border Grid.Row="1" Style="{StaticResource BarraInferior}" Padding="12,10" IsVisible="{Binding Cargado}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Border Style="{StaticResource Campo}" StrokeShape="RoundRectangle 22" MinimumHeightRequest="44" HeightRequest="44" Padding="16,0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}"
                        StrokeThickness="0">
                    <Entry Text="{Binding NuevoComentario}" Placeholder="Escribe un comentario…" MaxLength="500" FontSize="14"
                           MinimumHeightRequest="40" ReturnCommand="{Binding ComentarCommand}" />
                </Border>
                <Button Grid.Column="1" Style="{StaticResource BotonIcono}" Text="{x:Static h:Iconos.Enviar}" FontSize="18"
                        WidthRequest="44" HeightRequest="44" CornerRadius="22" BorderWidth="0" Shadow="{x:Null}"
                        BackgroundColor="{StaticResource Primary}" TextColor="White"
                        Command="{Binding ComentarCommand}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
