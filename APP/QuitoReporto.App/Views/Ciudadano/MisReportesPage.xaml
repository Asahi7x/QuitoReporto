<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QuitoReporto.App.ViewModels.Ciudadano"
             xmlns:m="clr-namespace:QuitoReporto.App.Models"
             xmlns:h="clr-namespace:QuitoReporto.App.Helpers"
             x:Class="QuitoReporto.App.Views.Ciudadano.MisReportesPage"
             x:DataType="vm:MisReportesViewModel"
             Title="Mis reportes">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16,16,16,0" RowSpacing="14">
        <VerticalStackLayout Spacing="2">
            <Label Text="{Binding Saludo}" Style="{StaticResource TextoTitulo}" />
            <Label Text="Sigue el avance de los problemas que reportaste." Style="{StaticResource TextoSecundario}" />
        </VerticalStackLayout>

        <!-- Buscador y filtro -->
        <Grid Grid.Row="1" ColumnDefinitions="*,132" ColumnSpacing="8">
            <Border Style="{StaticResource Campo}" MinimumHeightRequest="44" HeightRequest="44" Padding="12,0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Style="{StaticResource Icono}" Text="{x:Static h:Iconos.Buscar}" FontSize="16" />
                    <Entry Grid.Column="1" Text="{Binding Buscar}" Placeholder="Buscar" FontSize="14" MinimumHeightRequest="40"
                           ReturnType="Search" h:ResaltarAlEnfocar.Activo="True" />
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Campo}" MinimumHeightRequest="44" HeightRequest="44" Padding="12,0">
                <Grid>
                    <Picker Title="Estado" ItemsSource="{Binding Estados}"
                            ItemDisplayBinding="{Binding Texto, x:DataType=m:OpcionEstado}"
                            SelectedItem="{Binding EstadoSeleccionado}" Margin="0,0,18,0" />
                    <Label Style="{StaticResource Icono}" Text="{x:Static h:Iconos.Abajo}" FontSize="16"
                           HorizontalOptions="End" InputTransparent="True" />
                </Grid>
            </Border>
        </Grid>

        <RefreshView Grid.Row="2" IsRefreshing="{Binding Refrescando}" Command="{Binding CargarCommand}">
            <CollectionView x:Name="Lista" ItemsSource="{Binding Reportes}" SelectionMode="Single"
                            SelectionChangedCommand="{Binding AbrirCommand}"
                            SelectionChangedCommandParameter="{Binding SelectedItem, Source={x:Reference Lista}, x:DataType=CollectionView}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.Footer>
                    <BoxView HeightRequest="16" Color="Transparent" />
                </CollectionView.Footer>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="32,56" Spacing="12" IsVisible="{Binding SinResultados}">
                        <Border Style="{StaticResource IconoFondo}" WidthRequest="56" HeightRequest="56" StrokeShape="RoundRectangle 28"
                                HorizontalOptions="Center">
                            <Label Style="{StaticResource Icono}" Text="{x:Static h:Iconos.Documento}" FontSize="24" />
                        </Border>
                        <Label Text="{Binding TextoVacio}" HorizontalTextAlignment="Center" Style="{StaticResource TextoSecundario}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:Reporte">
                        <Border Style="{StaticResource Tarjeta}" Padding="12">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>
                            <Grid ColumnDefinitions="68,*,Auto" ColumnSpacing="12">
                                <Border Style="{StaticResource Miniatura}" WidthRequest="68" HeightRequest="68" VerticalOptions="Start">
                                    <Grid>
                                        <Label Style="{StaticResource Icono}" Text="{Binding CategoriaIcono}" FontSize="22"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSubtle}, Dark={StaticResource TextSubtleDark}}" />
                                        <Image Source="{Binding FotoUrl}" Aspect="AspectFill" />
                                    </Grid>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding Titulo}" Style="{StaticResource TextoFuerte}" LineBreakMode="TailTruncation" />
                                    <Label Style="{StaticResource TextoPequeno}" LineBreakMode="TailTruncation">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding CategoriaTexto}" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                                                <Span Text="  ·  " TextColor="{AppThemeBinding Light={StaticResource TextSubtle}, Dark={StaticResource TextSubtleDark}}" />
                                                <Span Text="{Binding FechaTexto}" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                        <Border Style="{StaticResource Etiqueta}" BackgroundColor="{Binding Estado, Converter={StaticResource EstadoAFondo}}">
                                            <HorizontalStackLayout Spacing="6">
                                                <Border WidthRequest="6" HeightRequest="6" StrokeShape="RoundRectangle 3" VerticalOptions="Center"
                                                        BackgroundColor="{Binding Estado, Converter={StaticResource EstadoATexto}}" />
                                                <Label Text="{Binding EstadoTexto}" FontSize="12" FontFamily="InterSemiBold"
                                                       TextColor="{Binding Estado, Converter={StaticResource EstadoATexto}}" />
                                            </HorizontalStackLayout>
                                        </Border>
                                        <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                            <Label Style="{StaticResource Icono}" Text="{x:Static h:Iconos.Apoyo}" FontSize="14" />
                                            <Label Text="{Binding Apoyos}" Style="{StaticResource TextoPequeno}" Margin="0,0,8,0" />
                                            <Label Style="{StaticResource Icono}" Text="{x:Static h:Iconos.Comentario}" FontSize="14" />
                                            <Label Text="{Binding ComentariosTotal}" Style="{StaticResource TextoPequeno}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Style="{StaticResource Icono}" Text="{x:Static h:Iconos.Derecha}" FontSize="18"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSubtle}, Dark={StaticResource TextSubtleDark}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
