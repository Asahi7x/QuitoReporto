<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QuitoReporto.App.ViewModels.Ciudadano"
             xmlns:m="clr-namespace:QuitoReporto.App.Models"
             xmlns:h="clr-namespace:QuitoReporto.App.Helpers"
             x:Class="QuitoReporto.App.Views.Ciudadano.NuevoReportePage"
             x:DataType="vm:NuevoReporteViewModel"
             Title="Nuevo reporte"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="28,28,28,32" Spacing="22">

            <Label Text="Nuevo reporte" Style="{StaticResource TextoTitulo}" />

            <!-- CU-03 Foto -->
            <VerticalStackLayout Spacing="8">
                <Border StrokeShape="RoundRectangle 28" HeightRequest="200" IsVisible="{Binding TieneFoto}"
                        BackgroundColor="{StaticResource White}">
                    <Grid>
                        <Image Source="{Binding RutaFoto}" Aspect="AspectFill" />
                        <Button Style="{StaticResource BotonIcono}" Text="{x:Static h:Iconos.Cerrar}" FontSize="16"
                                WidthRequest="36" HeightRequest="36" CornerRadius="18"
                                BackgroundColor="#B3000000" TextColor="White" Shadow="{x:Null}"
                                HorizontalOptions="End" VerticalOptions="Start" Margin="10"
                                Command="{Binding QuitarFotoCommand}" />
                    </Grid>
                </Border>

                <Border StrokeShape="RoundRectangle 28" Padding="14" BackgroundColor="{StaticResource White}"
                        IsVisible="{Binding TieneFoto, Converter={StaticResource BoolInverso}}">
                    <Border StrokeShape="RoundRectangle 14" StrokeThickness="1.5" StrokeDashArray="4,3"
                            Stroke="#8A8A8A" HeightRequest="150" BackgroundColor="Transparent">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TomarFotoCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" Spacing="6">
                            <Label Style="{StaticResource Icono}" Text="{x:Static h:Iconos.Camara}" FontSize="30"
                                   TextColor="#596273" />
                            <Label Text="Tomar foto del problema" FontSize="22" TextColor="#3C3C3C"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Border>

                <Button Text="O elegir de la galería" Style="{StaticResource BotonEnlace}" HorizontalOptions="Center"
                        HeightRequest="32" FontSize="18" Command="{Binding ElegirFotoCommand}"
                        IsVisible="{Binding TieneFoto, Converter={StaticResource BoolInverso}}" />
            </VerticalStackLayout>

            <!-- Categoría -->
            <VerticalStackLayout Spacing="10">
                <Label Text="Categoria" Style="{StaticResource TextoCampo}" />
                <CollectionView ItemsSource="{Binding Categorias}" SelectionMode="Single"
                                SelectedItem="{Binding CategoriaSeleccionada}" HeightRequest="46">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="m:OpcionCategoria">
                            <Border StrokeShape="RoundRectangle 22" HeightRequest="44" Padding="22,0"
                                    BackgroundColor="{StaticResource Verde}" Stroke="Transparent" StrokeThickness="3">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="Stroke" Value="White" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                                <Label Text="{Binding Texto}" FontSize="22" VerticalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Título -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Titulo" Style="{StaticResource TextoCampo}" />
                <Border Style="{StaticResource Campo}">
                    <Entry Text="{Binding Titulo}" Placeholder="Ej.: Bache grande en la Av. 6 de Diciembre" MaxLength="120"
                           h:ResaltarAlEnfocar.Activo="True" />
                </Border>
            </VerticalStackLayout>

            <!-- CU-04 Ubicación -->
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="16">
                    <Label Text="Ubicacion" Style="{StaticResource TextoCampo}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Style="{StaticResource BotonIcono}" Text="{x:Static h:Iconos.Pin}"
                            SemanticProperties.Description="Usar mi ubicación actual"
                            Command="{Binding ObtenerUbicacionCommand}" />
                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="0">
                        <Label Text="{Binding TextoUbicacion}" FontSize="18" TextColor="{StaticResource Gris}"
                               LineBreakMode="TailTruncation" MaxLines="2" />
                        <Label Text="Obteniendo tu ubicación…" FontSize="16" TextColor="{StaticResource Gris}"
                               IsVisible="{Binding BuscandoUbicacion}" />
                        <Label Text="Elegida en el mapa" FontSize="16" TextColor="{StaticResource Gris}"
                               IsVisible="{Binding UbicacionManual}" />
                    </VerticalStackLayout>
                </Grid>
                <Button Text="Ajustar en el mapa" Style="{StaticResource BotonEnlace}" HorizontalOptions="Start"
                        HeightRequest="32" Padding="0" TextColor="White" FontSize="19"
                        Command="{Binding ElegirEnMapaCommand}" />
            </VerticalStackLayout>

            <!-- Descripción -->
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Descripcion" Style="{StaticResource TextoCampo}" />
                    <Label Grid.Column="1" Text="Opcional" Style="{StaticResource TextoPequeno}" VerticalOptions="End" />
                </Grid>
                <Border BackgroundColor="{StaticResource White}" StrokeShape="RoundRectangle 28" Padding="18,8">
                    <Editor Text="{Binding Descripcion}" Placeholder="Tamaño, referencias cercanas, desde cuándo está así…"
                            AutoSize="TextChanges" MinimumHeightRequest="110" MaxLength="1000"
                            h:ResaltarAlEnfocar.Activo="True" />
                </Border>
            </VerticalStackLayout>

            <Border Style="{StaticResource AvisoError}" IsVisible="{Binding Error, Converter={StaticResource NoVacio}}">
                <Label Text="{Binding Error}" Style="{StaticResource TextoError}" />
            </Border>

            <!-- Enviar -->
            <Grid HorizontalOptions="Center" Margin="0,6,0,0">
                <Button Text="Enviar reporte" Command="{Binding EnviarCommand}" IsVisible="{Binding NoOcupado}"
                        HeightRequest="56" WidthRequest="240" CornerRadius="22" FontSize="24" />
                <Border HeightRequest="56" WidthRequest="240" StrokeShape="RoundRectangle 22"
                        BackgroundColor="{StaticResource Verde}" IsVisible="{Binding Ocupado}">
                    <ActivityIndicator IsRunning="{Binding Ocupado}" Color="White" HeightRequest="22" WidthRequest="22" />
                </Border>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
