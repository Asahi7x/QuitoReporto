<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QuitoReporto.App.ViewModels.Auth"
             xmlns:h="clr-namespace:QuitoReporto.App.Helpers"
             x:Class="QuitoReporto.App.Views.Auth.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Iniciar sesión"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Navy}">

    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="40,40,40,16" Spacing="0">

                <!-- LOGO: reservado (170 x 170). Para agregarlo, coloca el archivo en Resources/Images y descomenta:
                     <Image Source="logo.png" Aspect="AspectFit" /> -->
                <Grid HeightRequest="170" WidthRequest="170" HorizontalOptions="Center" Margin="0,16,0,0" />

                <Label Text="QuitoReporta" Style="{StaticResource AuthMarca}" Margin="0,12,0,28" />

                <Label Text="Usuario" Style="{StaticResource AuthEtiqueta}" />
                <Border Style="{StaticResource Campo}" Margin="0,6,0,14">
                    <Entry Text="{Binding Correo}" Style="{StaticResource AuthEntry}"
                           Keyboard="Email" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                           h:ResaltarAlEnfocar.Activo="True" />
                </Border>

                <Label Text="Clave" Style="{StaticResource AuthEtiqueta}" />
                <Border Style="{StaticResource Campo}" Margin="0,6,0,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry x:Name="CampoClave" Text="{Binding Clave}" Style="{StaticResource AuthEntry}"
                               IsPassword="True" ReturnCommand="{Binding IniciarSesionCommand}"
                               h:ResaltarAlEnfocar.Activo="True" />
                        <Label x:Name="IconoOjo" Grid.Column="1" Style="{StaticResource Icono}" Text="{x:Static h:Iconos.Ojo}"
                               FontSize="18" TextColor="#596273" Padding="8,12" Margin="0,0,-8,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="AlAlternarClave" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Border>

                <!-- Error -->
                <Border Style="{StaticResource AvisoError}" Margin="0,16,0,0"
                        IsVisible="{Binding Error, Converter={StaticResource NoVacio}}">
                    <Label Text="{Binding Error}" Style="{StaticResource AuthTexto}" TextColor="White" />
                </Border>

                <Grid Margin="0,32,0,0" ColumnDefinitions="*,Auto,*" ColumnSpacing="10" HorizontalOptions="Center">
                    <Button Grid.Column="1" Text="Ingresar" Style="{StaticResource BotonAuth}"
                            Command="{Binding IniciarSesionCommand}" IsVisible="{Binding NoOcupado}" />
                    <Border Grid.Column="1" HeightRequest="52" WidthRequest="124" StrokeShape="RoundRectangle 18"
                            BackgroundColor="{StaticResource Verde}" IsVisible="{Binding Ocupado}">
                        <ActivityIndicator IsRunning="{Binding Ocupado}" Color="White" HeightRequest="22" WidthRequest="22" />
                    </Border>

                    <!-- Ingresar con huella (solo si se activó en este teléfono) -->
                    <Button Grid.Column="2" Text="{x:Static h:Iconos.Huella}" FontFamily="Icons" FontSize="24"
                            HeightRequest="52" WidthRequest="52" Padding="0" CornerRadius="18"
                            BackgroundColor="White" TextColor="{StaticResource Verde}" HorizontalOptions="Start"
                            IsVisible="{Binding HuellaActiva}" IsEnabled="{Binding NoOcupado}"
                            SemanticProperties.Description="Ingresar con huella"
                            Command="{Binding IngresarConHuellaCommand}" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" Padding="0,8,0,28" Spacing="0" HorizontalOptions="Center">
            <Button Text="Registrarse" Style="{StaticResource BotonEnlaceAuth}" Command="{Binding IrARegistroCommand}" />
            <Button Text="¿Olvidaste tu contraseña?" Style="{StaticResource BotonEnlaceAuth}" Command="{Binding IrARecuperarCommand}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
