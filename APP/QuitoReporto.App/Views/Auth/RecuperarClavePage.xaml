<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QuitoReporto.App.ViewModels.Auth"
             xmlns:h="clr-namespace:QuitoReporto.App.Helpers"
             x:Class="QuitoReporto.App.Views.Auth.RecuperarClavePage"
             x:DataType="vm:RecuperarClaveViewModel"
             Title=""
             BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="24,8,24,32" Spacing="16">

            <Border Style="{StaticResource IconoFondo}" WidthRequest="48" HeightRequest="48" StrokeShape="RoundRectangle 14"
                    HorizontalOptions="Start"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySubtle}, Dark={StaticResource PrimarySubtleDark}}">
                <Label Style="{StaticResource Icono}" Text="{x:Static h:Iconos.Llave}" FontSize="22"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
            </Border>

            <!-- Paso 1: correo -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding PasoCorreo}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Recupera tu acceso" Style="{StaticResource TextoDisplay}" />
                    <Label Text="Escribe el correo de tu cuenta y te enviaremos un código de verificación de 6 dígitos."
                           Style="{StaticResource TextoSecundario}" LineHeight="1.3" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="8" Margin="0,8,0,0">
                    <Label Text="Correo electrónico" Style="{StaticResource TextoCampo}" />
                    <Border Style="{StaticResource Campo}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Style="{StaticResource Icono}" Text="{x:Static h:Iconos.Correo}" FontSize="18" />
                            <Entry Grid.Column="1" Text="{Binding Correo}" Placeholder="nombre@correo.com" Keyboard="Email"
                                   IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                                   ReturnCommand="{Binding EnviarCodigoCommand}" h:ResaltarAlEnfocar.Activo="True" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
                <Button Text="Enviar código" Command="{Binding EnviarCodigoCommand}" Margin="0,8,0,0" />
            </VerticalStackLayout>

            <!-- Paso 2: código y nueva clave -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding CodigoEnviado}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Revisa tu correo" Style="{StaticResource TextoDisplay}" />
                    <Label Style="{StaticResource TextoSecundario}" LineHeight="1.3">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Enviamos un código de 6 dígitos a " TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                                <Span Text="{Binding Correo}" FontFamily="InterSemiBold" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8" Margin="0,8,0,0">
                    <Label Text="Código de verificación" Style="{StaticResource TextoCampo}" />
                    <Border Style="{StaticResource Campo}" HeightRequest="60">
                        <Entry Text="{Binding Codigo}" Placeholder="000000" Keyboard="Numeric" MaxLength="6"
                               HorizontalTextAlignment="Center" FontSize="24" FontFamily="InterSemiBold" CharacterSpacing="10"
                               h:ResaltarAlEnfocar.Activo="True" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Nueva contraseña" Style="{StaticResource TextoCampo}" />
                    <Border Style="{StaticResource Campo}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Style="{StaticResource Icono}" Text="{x:Static h:Iconos.Candado}" FontSize="18" />
                            <Entry Grid.Column="1" Text="{Binding NuevaClave}" Placeholder="Mínimo 6 caracteres" IsPassword="True"
                                   h:ResaltarAlEnfocar.Activo="True" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Confirmar contraseña" Style="{StaticResource TextoCampo}" />
                    <Border Style="{StaticResource Campo}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Style="{StaticResource Icono}" Text="{x:Static h:Iconos.Candado}" FontSize="18" />
                            <Entry Grid.Column="1" Text="{Binding ConfirmarClave}" Placeholder="Repite la contraseña" IsPassword="True"
                                   ReturnCommand="{Binding RestablecerCommand}" h:ResaltarAlEnfocar.Activo="True" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Button Text="Restablecer contraseña" Command="{Binding RestablecerCommand}" Margin="0,8,0,0" />
                <Grid ColumnDefinitions="*,*">
                    <Button Text="Reenviar código" Style="{StaticResource BotonEnlace}" Command="{Binding EnviarCodigoCommand}" />
                    <Button Grid.Column="1" Text="Cambiar correo" Style="{StaticResource BotonEnlace}" Command="{Binding CambiarCorreoCommand}" />
                </Grid>
            </VerticalStackLayout>

            <Border Padding="12,10" StrokeShape="RoundRectangle 10"
                    BackgroundColor="{AppThemeBinding Light={StaticResource DangerSubtle}, Dark={StaticResource DangerSubtleDark}}"
                    IsVisible="{Binding Error, Converter={StaticResource NoVacio}}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Style="{StaticResource Icono}" Text="{x:Static h:Iconos.Alerta}" FontSize="16"
                           TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" VerticalOptions="Start" Margin="0,1,0,0" />
                    <Label Grid.Column="1" Text="{Binding Error}" Style="{StaticResource TextoError}" FontSize="14" />
                </Grid>
            </Border>

            <ActivityIndicator IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}" HeightRequest="24" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
