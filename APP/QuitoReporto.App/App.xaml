<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:QuitoReporto.App.Converters"
             x:Class="QuitoReporto.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:EstadoAColorConverter x:Key="EstadoAColor" />
            <conv:EstadoAFondoConverter x:Key="EstadoAFondo" />
            <conv:EstadoATextoConverter x:Key="EstadoATexto" />
            <conv:BoolInversoConverter x:Key="BoolInverso" />
            <conv:NoVacioConverter x:Key="NoVacio" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
